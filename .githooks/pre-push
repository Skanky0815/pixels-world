#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
head=$(git rev-parse HEAD)
updates=0
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_oid" in *[!0]*) ;; *) continue ;; esac
  if [ "$(git rev-parse "$local_oid^{commit}")" != "$head" ]; then
    echo 'Vor dem Push den zu prüfenden Branch auschecken; nur der aktuelle HEAD wird geprüft.' >&2
    exit 1
  fi
  updates=1
done
[ "$updates" = 1 ] || exit 0
if ! git diff --quiet HEAD --; then
  echo 'Vor der Push-Prüfung getrackte Änderungen committen oder separat sichern.' >&2
  exit 1
fi
exec npm run check:pr
