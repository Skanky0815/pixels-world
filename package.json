{
  "name": "pixels-world",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "qa": "npm run lint && npm run test:unit && npm run build",
    "build:e2e": "npm run typecheck && vite build --mode e2e --outDir dist-e2e",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --project=chromium --debug",
    "test:e2e:report": "playwright show-report",
    "test:unit:ci": "node --experimental-strip-types --test --test-reporter=spec --test-reporter=tap --test-reporter-destination=stdout --test-reporter-destination=test-reports/unit.tap tests/unit/*.test.ts",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.2.2"
  }
}
