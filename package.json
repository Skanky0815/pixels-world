{
  "name": "pixels-world",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "qa": "npm run format:check && npm run lint && npm run test:ci && npm run test:unit && npm run build",
    "build:e2e": "npm run typecheck && vite build --mode e2e --outDir dist-e2e",
    "test:e2e": "playwright test",
    "test:e2e:tablet:webkit": "E2E_TABLET_WEBKIT=1 playwright test",
    "test:e2e:full": "E2E_FULL_ROUND=1 playwright test",
    "test:e2e:slow": "E2E_FULL_ROUND=1 playwright test --grep @slow",
    "test:e2e:debug": "playwright test --project=chromium --debug",
    "test:e2e:report": "playwright show-report",
    "test:unit:ci": "node --experimental-strip-types --test --test-reporter=spec --test-reporter=tap --test-reporter-destination=stdout --test-reporter-destination=test-reports/unit.tap tests/unit/*.test.ts",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:pr": "npm run qa && npm run test:e2e",
    "hooks:install": "sh tools/install-hooks.sh",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:ci": "bash tests/ci/ensure-main-qa.sh && bash tests/ci/release-gates.sh && bash tests/ci/prepare-release.sh && bash tests/ci/pre-push.sh && node tests/ci/qa-scope.test.mjs && bash tests/ci/auto-publish.sh && node tests/ci/release-flow.test.mjs && bash tests/ci/release-qa-dispatch.sh && node --test tests/ci/release-notes.test.mjs tests/ci/release-preparation.test.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.14.0",
    "fflate": "0.8.3",
    "globals": "^17.14.0",
    "pngjs": "^7.0.0",
    "prettier": "3.9.10",
    "release-please": "17.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^2.0.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "minimatch": "11.0.4",
    "workbox-build": {
      "glob": "^14.0.2"
    }
  }
}
